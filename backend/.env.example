# Copy to .env and edit. Nothing here is required for the demo — every
# value below already has a working default.

# --- integrations -----------------------------------------------------
# true  = run against the mock verification and chain modules (default)
# false = use the real modules delivered by Pair A and Pair B
USE_MOCKS=true

# The mock ledger fails once on claim ids ending in 9, so mint_failed and
# its retry can be demonstrated. Set false to guarantee a clean run.
MOCK_CHAIN_FAILURES=true

# --- database ---------------------------------------------------------
# Unset  = SQLite at backend/data/app.db. No server, no credentials.
# Postgres or Supabase: paste the connection string here instead.
#   DATABASE_URL=postgresql+psycopg://user:password@host:5432/postgres
# Supabase: Project settings -> Database -> Connection string -> URI,
# then change the "postgresql://" prefix to "postgresql+psycopg://".
# DATABASE_URL=

# --- frontend ---------------------------------------------------------
# Set in frontend/.env.local, not here. Defaults to http://localhost:8000
# NEXT_PUBLIC_API_URL=http://localhost:8000
